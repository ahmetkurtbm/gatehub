# Yerel PostgreSQL (docker compose up -d). Boş bırakılırsa demo modu: veritabanı süreç
# içinde çalışır, "Demo hesabıyla gir" düğmesi görünür. Vercel'de boş bırakın.
DATABASE_URL=postgres://gatehub:gatehub@localhost:5437/gatehub

# En az 32 karakter: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3600

# İsteğe bağlı
ADMIN_USER_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=
